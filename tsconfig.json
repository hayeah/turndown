{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["vitest/globals", "node"],
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.test.shared.ts",
    "test/**/*.test.ts",
    "test/**/*.test.browser.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "lib"
  ]
}